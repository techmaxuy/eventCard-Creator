generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

enum Role {
  USER
  ADMIN
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  events        Event[]
  country       String?
  subscription  UserSubscription?
  tokenUsage    TokenUsage[]
  payments      Payment[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}

model Settings {
  id                    String   @id @default(cuid())
  appName               String   @default("MemberBase")
  welcomeMessageEn      String   @default("Welcome to the Member Base with Roles Application")
  welcomeMessageEs      String   @default("Bienvenido a la aplicación base de miembros con roles")
  logo                  String?
  favicon               String?
  defaultLocale         String   @default("en")
  backgroundImageMobile   String?
  backgroundImageDesktop  String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ========================================
// FEATURE: EVENT CARDS
// ========================================

// Tipos de eventos pre-configurados por admins
model EventType {
  id                String   @id @default(cuid())
  name              String   // "Cumpleaños", "Casamiento", etc.
  nameEn            String   // "Birthday", "Wedding"
  slug              String   @unique // "birthday", "wedding"
  description       String?
  descriptionEn     String?
  icon              String?  // Emoji o nombre de ícono
  color             String   @default("#3b82f6") // Color temático
  
  // Campos disponibles para este tipo
  hasDate           Boolean  @default(true)
  hasTime           Boolean  @default(true)
  hasLocation       Boolean  @default(true)
  hasDressCode      Boolean  @default(false)
  hasGiftRegistry   Boolean  @default(false)
  hasMenu           Boolean  @default(false)
  customFields      Json?    // Campos adicionales personalizados
  
  // Configuración visual
  defaultTheme      String   @default("classic")
  allowedThemes     Json?    // Array de temas disponibles
  hideGuestCount    Boolean  @default(false) // Ocultar contador de invitados en página pública
  allowDecorations  Boolean  @default(true)  // Permitir decoraciones en este tipo de evento

  // AI Wizard Configuration
  numberOfPeople    Int      @default(1)     // Number of people for this event (1=birthday, 2=wedding)
  askNames          Boolean  @default(true)  // Whether to ask for names in wizard

  // AI Prompt Supplements (admin-configured, added to user prompts)
  aiTitlePromptEs   String?  @db.Text // Spanish context for title generation
  aiTitlePromptEn   String?  @db.Text // English context for title generation
  aiPhrasePromptEs  String?  @db.Text // Spanish context for phrase generation
  aiPhrasePromptEn  String?  @db.Text // English context for phrase generation
  aiBackgroundPromptEs String? @db.Text // Spanish context for background image
  aiBackgroundPromptEn String? @db.Text // English context for background image
  aiPhotoPromptEs   String?  @db.Text // Spanish context for additional photo
  aiPhotoPromptEn   String?  @db.Text // English context for additional photo

  // Font Configuration
  showFonts         Boolean  @default(true)    // Whether to show font selector for this event type
  fontCategories    Json?    // Array of allowed font categories: ["playful", "elegant", "modern", "handwritten"]

  // Featured Image Configuration
  showFeaturedImage Boolean  @default(true)    // Whether to show/allow featured image for this event type

  // Countdown Configuration
  hasCountdown      Boolean  @default(true)    // Whether to allow countdown timer for this event type

  // Estado
  isActive          Boolean  @default(true)

  // Relaciones
  events            Event[]
  assets            Asset[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([slug])
  @@index([isActive])
}

// Eventos creados por usuarios
model Event {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  eventTypeId       String
  eventType         EventType   @relation(fields: [eventTypeId], references: [id])
  
  // URL pública única
  slug              String      @unique // "maria-cumple-30" 
  
  // Información básica
  title             String      // "Cumpleaños de María" (legacy, for backward compatibility)
  titleNames        String?     // Nombres de protagonistas: "María y Juan", "Lucía"
  titleMessage      String?     // Mensaje del título: "se casan", "cumple 30"
  description       String?     // Mensaje de bienvenida
  
  // Detalles del evento (campos comunes)
  eventDate         DateTime?
  eventTime         String?     // "19:00"
  location          String?     // "Salón Las Flores"
  locationAddress   String?     // Dirección completa
  locationUrl       String?     // Google Maps URL
  
  // Campos opcionales según tipo
  dressCode         String?     // "Formal", "Casual", etc.
  giftRegistry      String?     // URL o texto de registro de regalos
  giftRegistryType  String?     // "url" o "text" (default: "url")
  menu              String?     // Descripción del menú
  customData        Json?       // Campos personalizados adicionales
  
  // Personalización visual
  theme             String      @default("classic") // "classic", "modern", "elegant"
  primaryColor      String      @default("#3b82f6")
  coverImage        String?     // Imagen principal
  featuredImage     String?     // Imagen destacada (foto de pareja, cumpleañero, etc.)
  gallery           Json?       // Array de URLs de imágenes
  music             String?     // URL de música de fondo

  // NUEVO: Assets seleccionados
  welcomePhrase   String?
  musicUrl        String?

  // NUEVO: Personalización visual avanzada
  fontFamily      String?      // Fuente personalizada general (legacy, for backward compatibility)
  fontEventType   String?      // Fuente para el tipo de evento (ej: "Casamiento")
  fontTitle       String?      // Fuente para los nombres de protagonistas
  fontMessage     String?      // Fuente para el mensaje del título y frase de bienvenida
  fontBody        String?      // Fuente para el resto de la invitación
  colorEventType  String?      // Color para el tipo de evento
  colorTitle      String?      // Color para los nombres de protagonistas
  colorMessage    String?      // Color para la frase de bienvenida
  colorBody       String?      // Color para el resto de la invitación
  fontSizeEventType Int?       // Tamaño de fuente (%) para tipo de evento (default: 150)
  fontSizeTitle     Int?       // Tamaño de fuente (%) para nombres (default: 200)
  fontSizeMessage   Int?       // Tamaño de fuente (%) para frase de bienvenida (default: 150)
  fontSizeBody      Int?       // Tamaño de fuente (%) para resto de invitación (default: 50)
  welcomePhrasePosition String? // Posición de la frase: 'above' o 'below' nombres (default: 'below')
  decorations     Json?        // Array de decoraciones: [{assetId, position}]
  particleEffect  String?      // Efecto de partículas: "confetti", "petals", "bubbles", "stars", "none" (null = usar default del tipo de evento)

  // Configuración
  isPublished       Boolean     @default(false)
  allowComments     Boolean     @default(false)
  maxGuests         Int?        // Límite de confirmaciones
  requirePhone      Boolean     @default(true)
  askDietaryRequirements Boolean @default(false) // Preguntar por requerimientos alimenticios
  showCountdown     Boolean     @default(false)   // Show countdown timer on public page

  // Gift Registry Feature
  showGiftRegistry      Boolean     @default(false)  // Enable gift registry for this event
  giftRegistryImage     String?     // AI-generated image of registered gifts
  giftRegistryEmptyImage String?    // Default empty image when no gifts registered

  // Estadísticas
  views             Int         @default(0)
  shares            Int         @default(0)

  // Relaciones
  guests            Guest[]
  giftRegistrations GiftRegistration[]
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([userId])
  @@index([slug])
  @@index([eventTypeId])
  @@index([isPublished])
}

// Invitados que confirman asistencia
model Guest {
  id                String      @id @default(cuid())
  eventId           String
  event             Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Información del invitado
  name              String
  phone             String
  email             String?
  
  // Confirmación
  status            GuestStatus @default(PENDING)
  numberOfGuests    Int         @default(1) // Cuántas personas trae
  message           String?     // Mensaje opcional del invitado

  // Requerimientos alimenticios
  dietaryRequirements Json?     // Array de strings: ["celiac", "vegan", "vegetarian", "allergic"]
  dietaryNotes        String?   // Notas adicionales (ej: "alérgico a maní")

  // Metadata
  ipAddress         String?
  userAgent         String?

  // Gift Registrations
  giftRegistrations GiftRegistration[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([eventId])
  @@index([phone])
  @@index([status])
}

// Gift registrations by confirmed guests
model GiftRegistration {
  id          String   @id @default(cuid())
  eventId     String
  guestId     String
  giftName    String   // "Tostadora", "Juego de sábanas", etc.
  description String?  // Optional description
  quantity    Int      @default(1)

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@index([guestId])
}

enum GuestStatus {
  PENDING
  CONFIRMED
  DECLINED
  MAYBE
}

enum AssetType {
  IMAGE
  AUDIO
  PHRASE
  DECORATION  // Decoraciones: globos, tortas, velas, confetti, etc.
}

model Asset {
  id            String    @id @default(cuid())
  type          AssetType
  eventTypeId   String?   // Null = disponible para todos los tipos
  
  // Para imágenes
  imageUrl      String?
  thumbnailUrl  String?   // Thumbnail pequeño para preview
  
  // Para audios
  audioUrl      String?
  audioDuration Int?      // Duración en segundos
  
  // Para frases
  phraseEs      String?   // Frase en español
  phraseEn      String?   // Frase en inglés

  // Para decoraciones
  decorationUrl      String?  // URL del PNG/SVG transparente
  decorationType     String?  // 'balloon', 'cake', 'candles', 'confetti', 'banner', 'stars'
  decorationPosition String?  // 'top-left', 'top-right', 'bottom-left', 'bottom-right', 'floating'

  // Metadata
  name          String
  description   String?
  tags          Json?     // Array de tags para búsqueda
  isActive      Boolean   @default(true)
  order         Int       @default(0) // Para ordenar

  eventType     EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([type, eventTypeId, isActive])
}

model AIConfig {
  id            String     @id @default(cuid())
  name          String
  provider      AIProvider
  apiKey        String
  defaultModel  String     // Model for text generation (titles, phrases, etc.)
  imageModel    String?    // Model for image generation/enhancement (optional, uses defaultModel if null)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String   @unique
  displayNameEn   String
  displayNameEs   String
  tokens          Int
  price           Float
  additionalLimit Int      @default(0)
  maxEvents       Int      @default(-1)  // -1 = unlimited, 1 = free plan limit
  hasAIAccess     Boolean  @default(false) // Whether this plan has AI features access
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   UserSubscription[]
}

// Configuración de costos de IA para eventos
model EventAISettings {
  id                      String   @id @default(cuid())

  // Costo en tokens por operación de IA
  phraseGenerationCost    Int      @default(1)   // Costo para generar frases con IA
  imageEditCost           Int      @default(5)   // Costo para edición/mejora de imágenes con IA
  imageGenerationCost     Int      @default(10)  // Costo para generación de imágenes con IA
  descriptionGenerationCost Int    @default(1)   // Costo para generar descripciones
  suggestionsCost         Int      @default(1)   // Costo para sugerencias de IA

  // Configuraciones adicionales
  isAIEnabled             Boolean  @default(true) // Habilitar/deshabilitar IA globalmente

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model UserSubscription {
  id              String            @id @default(cuid())
  userId          String            @unique
  planId          String
  tokensUsed      Int               @default(0)
  tokensRemaining Int               @default(0)
  startDate       DateTime          @default(now())
  renewalDate     DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan  @relation(fields: [planId], references: [id])
}

model TokenUsage {
  id          String   @id @default(cuid())
  userId      String
  tokensUsed  Int
  operation   String
  aiConfigId  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentGateway {
  id           String   @id @default(cuid())
  countryCode  String
  countryName  String
  gatewayName  String
  paymentLink  String?
  instructions String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments     Payment[]
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  planId          String
  gatewayId       String
  amount          Float
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  receiptImage    String?
  adminNotes      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway         PaymentGateway @relation(fields: [gatewayId], references: [id])
}
